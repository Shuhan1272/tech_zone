{
  "name": "techzone-react-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host localhost --port 3000 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "format:admin": "prettier --write src/admin tests/admin-export.test.mjs",
    "format:check": "prettier --check src/admin tests/admin-export.test.mjs"
  },
  "dependencies": {
    "expo": "^58.0.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.0"
  }
}
